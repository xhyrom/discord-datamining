        ]
      },
      {
        "sha": "c85e7b6cd5f812081bbfe44fb657ce89ffebfcc3",
        "node_id": "MDY6Q29tbWl0MjAxMTMzNzYxOmM4NWU3YjZjZDVmODEyMDgxYmJmZTQ0ZmI2NTdjZTg5ZmZlYmZjYzM=",
        "commit": {
          "author": {
            "name": "Ivo List",
            "email": "ilist@google.com",
            "date": "2020-11-18T18:26:51Z"
          },
          "committer": {
            "name": "GitHub",
            "email": "noreply@github.com",
            "date": "2020-11-18T18:26:51Z"
          },
          "message": "Fix conditional select on darwin. (#1674)\n\nBazel is changing how @bazel_tools/conditions:darwin is implemented.\r\nWith old implementation based on flags, it was ok to have darwin and\r\ndarwin_x86_64 in a select. This was base on flag --cpu=darwin and\r\n--cpu=dawin_x86_64.\r\n\r\nNew implementation is based on constraints, where \"darwin\" means OS (and\r\nany CPU), while \"darwin_x86_64\" mean only specific CPU. As such they\r\ncannot be used in the same select, because the selection would be\r\nambiguous.",
          "tree": {
