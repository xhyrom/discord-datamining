        "number": 2,
        "title": "remove color panel border, and remove extra spacing",
        "user": {
          "login": "donaldchen",
          "id": 3821698,
          "node_id": "MDQ6VXNlcjM4MjE2OTg=",
          "gravatar_id": "",
          "url": "https://api.github.com/users/donaldchen",
          "type": "User",
