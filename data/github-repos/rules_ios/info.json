        "number": 2,
        "title": "[transitions] Do not remove cpus from configured target graph",
        "user": {
          "login": "nataliejameson",
          "id": 6351854,
          "node_id": "MDQ6VXNlcjYzNTE4NTQ=",
          "gravatar_id": "",
