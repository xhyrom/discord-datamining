      },
      {
        "sha": "8004045251384848570420b1446b811ca5694530",
        "node_id": "MDY6Q29tbWl0ODM0ODkwNjg6ODAwNDA0NTI1MTM4NDg0ODU3MDQyMGIxNDQ2YjgxMWNhNTY5NDUzMA==",
        "commit": {
          "author": {
            "name": "Fred Hebert",
            "email": "mononcqc@ferd.ca",
            "date": "2016-12-08T12:27:04Z"
          },
          "committer": {
            "name": "Fred Hebert",
            "email": "mononcqc@ferd.ca",
            "date": "2016-12-08T12:29:05Z"
          },
          "message": "Using set path fixes weird priv_dir issues.\n\nI'm not 100% sure how, but it seems that using `set_path` instead of\njust `add_path` changes how libraries are looked into by the Erlang VM\nwhen it comes to priv dirs and lib dirs.\n\nThis commit forces the addition of apps' paths through this function\nrather than just adding the paths, which appears to fix some subtle bugs\nin umbrella apps with private tests requiring access to priv and lib\ndirs for the app they're part of.",
          "tree": {
            "sha": "de159cb84c3787fb073f52a3e6a9270ce46f2491",
            "url": "https://api.github.com/repos/discord/rebar3_proper/git/trees/de159cb84c3787fb073f52a3e6a9270ce46f2491"
          },
