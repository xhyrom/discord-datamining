      {
        "sha": "2ca32e0405ad5c45da0f4c5aa09a1a68352a6c6b",
        "node_id": "MDY6Q29tbWl0MTUyNjY2NDk0OjJjYTMyZTA0MDVhZDVjNDVkYTBmNGM1YWEwOWExYTY4MzUyYTZjNmI=",
        "commit": {
          "author": {
            "name": "Daniel Bevenius",
            "email": "daniel.bevenius@gmail.com",
            "date": "2017-04-18T06:20:56Z"
          },
          "committer": {
            "name": "Rod Vagg",
            "email": "rod@vagg.org",
            "date": "2018-08-09T00:51:07Z"
          },
          "message": "gyp: fix ninja build failure (GYP patch)\n\nCurrently the files specified in libraries in node.gyp `cctest` target are\ngetting a '.lib' extension on windows when generated with ninja.\nThis commit adds a check to see if a file has a '.obj' extension and in\nthat case no '.lib' extension will be added.\n\nAlso, the LIBS specified in the 'libraries' section are not\nbeing included in the --start-group --end-group section which\nmeans that these libraries will not be searched causing issue\nwith linkers where the order matters.\n\nPR-URL: https://github.com/nodejs/node/pull/12484\nFixes: https://github.com/nodejs/node/issues/12448\nReviewed-By: Benjamin Gruenbaum <benjamingr@gmail.com>\nReviewed-By: James M Snell <jasnell@gmail.com>\nReviewed-By: Refael Ackermann <refack@gmail.com>\nReviewed-By: Gibson Fahnestock <gibfahn@gmail.com>",
          "tree": {
            "sha": "5a9689c135c6a9b14c91d2868774c2ce50832e8d",
            "url": "https://api.github.com/repos/discord/node-gyp/git/trees/5a9689c135c6a9b14c91d2868774c2ce50832e8d"
          },
