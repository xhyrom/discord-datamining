---
export interface Props {
  value: string;
  theme: string;
}

const { value, theme, ...attrs } = Astro.props;
---

<div is="code-editor" data-value={value} data-theme={theme} {...attrs}></div>

<script>
  import "./TSEditor.client.js";
</script>

<style>
  [is="code-editor"] {
    display: flex;
    flex-direction: column;
    height: 100vh;
    margin: 0;
  }
</style>
