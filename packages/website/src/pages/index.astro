---
import Layout from "~/layouts/Layout.astro";
import { CONFIG } from "~/config";
import Button from "~/components/widgets/Button.astro";
---

<Layout>
  <main class="h-full overflow-hidden pb-4 text-white">
    <div class="flex h-full flex-col items-center justify-center gap-y-6">
      <h1 class="text-center text-6xl font-extrabold text-white">
        {CONFIG.name}
      </h1>
      <h2 class="text-center text-3xl text-gray-500">
        The most powerful datamining 🎉
      </h2>

      <div class="flex flex-wrap justify-center gap-6">
        <Button name="Experiments" href="/experiments" />
        <Button name="Scripts" href="/scripts" />
        <Button name="Stylesheet" href="/stylesheet" />
        <Button name="Blog Posts" href="/blog-posts" />
        <Button name="Support Articles" href="/support-articles" />
        <Button name="Support Dev Articles" href="/support-dev-articles" />
      </div>
    </div>
  </main>
</Layout>
