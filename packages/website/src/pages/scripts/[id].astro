---
import Layout from "~/layouts/Layout.astro";
import Editor from "~/components/editors/TSEditor.astro";

import { scripts } from "~/utils";
export async function getStaticPaths() {
  return scripts.map((script) => {
    return {
      params: { id: script.name },
      props: script,
    };
  });
}

const { content } = Astro.props;
---

<Layout class="overflow-hidden">
  <Editor value={content} theme="vs-dark" />
</Layout>
