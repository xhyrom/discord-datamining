---
import Layout from "~/layouts/Layout.astro";

import { blogPosts } from "~/utils";
export async function getStaticPaths() {
  return blogPosts.map((post) => {
    return {
      params: { id: post.id },
      props: post,
    };
  });
}

const { data, content } = Astro.props;
---

<Layout>
  <h1 class="w-full py-32 text-center text-5xl font-extrabold text-white">
    {data.title}
  </h1>

  <div
    class="prose prose-invert mx-auto w-full content-center justify-center text-2xl"
  >
    <article set:html={content} />
  </div>
</Layout>
