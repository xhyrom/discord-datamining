---
import Layout from "~/layouts/Layout.astro";
import { CONFIG } from "~/config";
import Button from "~/components/widgets/Button.astro";
import { scripts } from "~/utils";
---

<Layout>
  <main class="h-full pb-4 text-white">
    <div class="flex h-full flex-col items-center justify-center gap-y-6">
      <h1 class="text-center text-6xl font-extrabold text-white">
        {CONFIG.name}
      </h1>
      <h2 class="text-center text-3xl text-gray-500">View latest scripts</h2>

      <div class="flex flex-wrap justify-center gap-6">
        {
          scripts.map((script) => (
            <Button name={script.name} href={`/scripts/${script.name}`} />
          ))
        }
      </div>
    </div>
  </main>
</Layout>
