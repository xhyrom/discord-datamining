---
import Layout from "~/layouts/Layout.astro";
import { CONFIG } from "~/config";
import Button from "~/components/widgets/Button.astro";
import { stylesheets } from "~/utils";
---

<Layout>
  <main class="h-full pb-4 text-white">
    <div class="flex h-full flex-col items-center justify-center gap-y-6">
      <h1 class="text-center text-6xl font-extrabold text-white">
        {CONFIG.name}
      </h1>
      <h2 class="text-center text-3xl text-gray-500">
        View latest stylesheets
      </h2>

      <div class="flex flex-wrap justify-center gap-6">
        {
          stylesheets.map((stylesheet) => (
            <Button
              name={stylesheet.name}
              href={`/stylesheets/${stylesheet.name}`}
            />
          ))
        }
      </div>
    </div>
  </main>
</Layout>
